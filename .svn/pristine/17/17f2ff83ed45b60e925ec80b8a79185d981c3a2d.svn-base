                        _FAXNO = dt.Rows[0]["FAXNO"]?.ToString();               // 팩스번호
                        //_FAXYN = dt.Rows[0]["FAXYN"]?.ToString();               // 웹팩스 여부
                    }
                    else if (dt.Rows.Count == 0)
