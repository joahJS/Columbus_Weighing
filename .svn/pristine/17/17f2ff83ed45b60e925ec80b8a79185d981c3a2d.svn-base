            {
                string SEQNO = Gv_Car.GetFocusedRowCellValue("SEQNO")?.ToString();
                _DicParams.Add("CMD", "CAR_TEMPLATE_BOUND");
                _DicParams.Add("SEQNO", SEQNO);
