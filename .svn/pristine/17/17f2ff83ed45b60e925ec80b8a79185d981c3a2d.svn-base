                _FAXNO = string.Empty;
                _FAXYN = string.Empty;

                SelectTabPage(3);   // 거래처 선택
                buttonTab4Next.Visible = false;
                listBoxCustomers.Visible = false;
                textBoxCustomer.Text = string.Empty;
                textBoxCustomer.Focus();
